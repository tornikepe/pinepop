# სერვერის პორტი
PORT=3000

# ბაზა. ცარიელი = ჩაშენებული PostgreSQL (PGlite) ფაილებად data/pglite-ში — ლოკალურად არაფრის დაყენება არ სჭირდება.
# ინტერნეტში გაშვებისას ჩაწერე ნებისმიერი PostgreSQL-ის მისამართი (Supabase, Neon, საკუთარი):
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# PGLITE_DIR=data/pglite

# ადმინ პანელის (/admin) პირველი ანგარიში — იქმნება მხოლოდ პირველ გაშვებაზე, როცა თანამშრომელი არ არსებობს.
# შემდეგ ლოგინი და პაროლი იცვლება ადმინიდან („ჩემი ანგარიში“). პაროლი მინ. 10 სიმბოლო.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# ჰოსტინგის proxy-ს უკან (Render, Railway, Nginx) ჩართე, რომ შეზღუდვებმა მომხმარებლის ნამდვილი IP დაინახოს.
# TRUST_PROXY=1
